# Job Agent Backend — Environment Configuration
# Copy this file to .env and adjust the values.
# Never commit .env (it is git-ignored).
#
# All keys map to the centralized Settings class in
# backend/app/shared/config/settings.py (UPPER_CASE env var -> group field).

# --- Application ---
APP_NAME=jobagent
APP_ENVIRONMENT=development        # development | staging | production
APP_DEBUG=false
APP_API_V1_PREFIX=/api/v1
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECURITY_SECRET_KEY=
SECURITY_JWT_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=30
SECURITY_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (PostgreSQL, SQLAlchemy async URL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobagent
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant (vector store) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=job_descriptions
QDRANT_EMBEDDING_DIMENSIONS=1024

# --- AI Providers ---
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.5-flash
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-sonnet-4-5
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-5.5
AI_VOYAGE_API_KEY=
AI_VOYAGE_MODEL=voyage-3-large
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3

# --- Playwright ---
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_SCREENSHOTS_DIR=artifacts/screenshots
PLAYWRIGHT_STORAGE_STATE_PATH=

# --- Logging ---
LOGGING_LEVEL=INFO
LOGGING_FORMAT=json             # json | text

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
